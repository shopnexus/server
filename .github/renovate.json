{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>shopnexus/shopnexus//.github/renovate/default.json5"
  ],
  "packageRules": [
    {
      "description": "CI runs no Go tests, so only patch updates of modules merge by themselves.",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "matchPackageNames": [
        "!github.com/restatedev/**"
      ],
      "groupName": "go minor",
      "automerge": false
    },
    {
      "description": "The compose stacks follow the umbrella's images, which a person merges.",
      "matchManagers": [
        "docker-compose"
      ],
      "automerge": false,
      "groupName": "compose images"
    }
  ]
}
