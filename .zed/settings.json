{
  "languages": {
    "SQL": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "sqlfluff",
          "arguments": ["format", "--stdin-filename", "{buffer_path}", "-"]
        }
      }
    }
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "gofumpt": true
      }
    }
  }
}
