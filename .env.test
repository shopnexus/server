# The test stack (docker-compose.test.yml), which make test starts. Tests read
# these through internal/platform/testenv; a variable set in the environment
# wins over this file.
TEST_DATABASE_URL=postgres://server2:server2@localhost:56433/server2_test?sslmode=disable
TEST_RESTATE_INGRESS_URL=http://127.0.0.1:56581
TEST_RESTATE_ADMIN_URL=http://127.0.0.1:56571
TEST_OBJECT_STORE_ENDPOINT=http://127.0.0.1:56491
TEST_OBJECT_STORE_PUBLIC_ENDPOINT=http://127.0.0.1:56491
TEST_OBJECT_STORE_REGION=us-east-1
TEST_OBJECT_STORE_ACCESS_KEY=server2rustfs
TEST_OBJECT_STORE_SECRET_KEY=server2rustfs-secret
TEST_OBJECT_STORE_BUCKET=server2-test
TEST_MEDIA_PUBLIC_URL=http://127.0.0.1:56491/server2-test
