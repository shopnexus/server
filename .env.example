COMPOSE_PROFILES=obs
APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text
DATABASE_URL=postgres://server2:server2@localhost:56432/server2?sslmode=disable
RESTATE_INGRESS_URL=http://127.0.0.1:56580
RESTATE_ADMIN_URL=http://127.0.0.1:56570
RESTATE_LISTEN_ADDR=127.0.0.1:9080
RESTATE_ENDPOINT_URL=http://127.0.0.1:9080
RESTATE_SERVICE_PREFIX=
# true registers this process's endpoint with Restate at start; the cluster
# sets false because restate-operator registers each version itself.
RESTATE_REGISTER=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:56318
SERVICE_NAME=server2
TRUSTED_PROXIES=
JWT_ISSUER=server2
JWT_AUDIENCE=shopnexus-app
# Set both during a key change; empty otherwise.
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY=
# The web console's origin; CORS allows it and nothing else.
CONSOLE_ORIGIN=http://localhost:5173
# The host of each ops dashboard behind the console's sign-in, as app=host
# pairs: grafana=grafana.x.vn,restate=restate.x.vn (apps: grafana, restate,
# litellm, s3, argocd). Empty refuses every dashboard; local stacks serve
# theirs without a sign-in.
DASHBOARD_HOSTS=
# The object store (RustFS in docker-compose.yml) and the base URL clients
# read processed photos under.
OBJECT_STORE_ENDPOINT=http://127.0.0.1:56490
# The same API as phones reach it, e.g. http://<this machine's LAN IP>:56490;
# presigned upload URLs sign its host.
OBJECT_STORE_PUBLIC_ENDPOINT=http://127.0.0.1:56490
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=server2rustfs
OBJECT_STORE_SECRET_KEY=server2rustfs-secret
OBJECT_STORE_BUCKET=server2
MEDIA_PUBLIC_URL=http://127.0.0.1:56490/server2
# The model that reads search queries, through an OpenAI-compatible API.
# Every one is required; make run stops and names the one left empty.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# The embedding models search uses (see ARCHITECTURE.md, Search). Locally the
# server calls TEI (text) and ai (photos) directly, which take no key; in the
# cluster both URLs are LiteLLM and the models its aliases. Start them with
#   docker compose --profile models up -d tei ai
EMBED_TEXT_BASE_URL=http://127.0.0.1:56800/v1
EMBED_IMAGE_BASE_URL=http://127.0.0.1:56810/v1
EMBED_TEXT_MODEL=bge-m3
EMBED_IMAGE_MODEL=siglip2-so400m-patch16-384
# The model behind each alias; a new value re-embeds through search-reindex.
EMBED_TEXT_VERSION=bge-m3@5617a9f6
EMBED_IMAGE_VERSION=siglip2-so400m-patch16-384-fp32@29f74e67
# Empty: TEI and ai have no keys. In the cluster: server-embed-index's and
# server-embed-search's keys.
EMBED_INDEX_API_KEY=
EMBED_SEARCH_API_KEY=
EMBED_TIMEOUT=10s
EMBED_SLOTS=2
# Starting floors; make search-eval tunes them.
EMBED_TEXT_MIN_SIMILARITY=0.45
EMBED_PHOTO_MIN_SIMILARITY=0.6
# Firebase: the project pushes go through and phone tokens come from, and
# where the keys that sign those tokens are published.
FIREBASE_PROJECT_ID=shopnexus-26aca
FIREBASE_PROJECT_NUMBER=5362373878
FIREBASE_AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
PNV_JWKS_URL=https://fpnv.googleapis.com/v1beta/jwks
# Accept the test numbers of PNV's test mode; APP_ENV=prod refuses true.
PNV_TEST_NUMBERS=true
# Pushes through Firebase Cloud Messaging: a service account's JSON in
# base64. Empty writes pushes to the log instead.
FCM_CREDENTIALS=
# How sign-in codes are mailed: log (development) or resend. APP_ENV=prod
# refuses log.
EMAIL_SENDER=log
# Resend's API key; required with EMAIL_SENDER=resend.
RESEND_API_KEY=
EMAIL_FROM=ShopNexus <no-reply@shopnexus.id.vn>
# Every variable is required; an empty value above is a setting, not a gap.
# make run appends JWT_KEY_ID, JWT_PRIVATE_KEY, CONSOLE_KEY, OTP_KEY and
# RESTATE_IDENTITY_KEY to .env on first use.
