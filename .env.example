COMPOSE_PROFILES=obs
APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text
DATABASE_URL=postgres://server2:server2@localhost:56432/server2?sslmode=disable
RESTATE_INGRESS_URL=http://127.0.0.1:56580
RESTATE_ADMIN_URL=http://127.0.0.1:56570
RESTATE_LISTEN_ADDR=127.0.0.1:9080
RESTATE_ENDPOINT_URL=http://127.0.0.1:9080
RESTATE_SERVICE_PREFIX=
# true registers this process's endpoint with Restate at start; the cluster
# sets false because restate-operator registers each version itself.
RESTATE_REGISTER=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:56318
SERVICE_NAME=server2
TRUSTED_PROXIES=
JWT_ISSUER=server2
JWT_AUDIENCE=shopnexus-app
# Set both during a key change; empty otherwise.
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY=
# The web console's origin; CORS allows it and nothing else.
CONSOLE_ORIGIN=http://localhost:5173
# The host of each ops dashboard behind the console's sign-in, as app=host
# pairs: grafana=grafana.x.vn,restate=restate.x.vn (apps: grafana, restate,
# litellm, s3, argocd). Empty refuses every dashboard; local stacks serve
# theirs without a sign-in.
DASHBOARD_HOSTS=
# Origins of the docs site, comma separated. Its API playground calls /v1/
# from them, without cookies. Empty allows none.
DOCS_ORIGINS=http://localhost:4321
# The object store (RustFS in docker-compose.yml) and the base URL clients
# read processed photos under.
OBJECT_STORE_ENDPOINT=http://127.0.0.1:56490
# The same API as phones reach it, e.g. http://<this machine's LAN IP>:56490;
# presigned upload URLs sign its host.
OBJECT_STORE_PUBLIC_ENDPOINT=http://127.0.0.1:56490
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=server2rustfs
OBJECT_STORE_SECRET_KEY=server2rustfs-secret
OBJECT_STORE_BUCKET=server2
MEDIA_PUBLIC_URL=http://127.0.0.1:56490/server2
# The model that reads search queries, through an OpenAI-compatible API:
# locally OpenRouter (https://openrouter.ai/api/v1) with your own key and a
# model such as anthropic/claude-haiku-5.5, as the cluster's ai-gateway uses.
# Every one is required; make run stops and names the one left empty.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# The embedding models search uses (see ARCHITECTURE.md, Search). Locally the
# server calls OpenRouter's baai/bge-m3 for text, with the OpenRouter key in
# EMBED_INDEX_API_KEY and EMBED_SEARCH_API_KEY, and ai-models for photos,
# which takes no key; in the cluster both URLs are ai-gateway and the models
# its aliases. Start ai-models with
#   docker compose --profile models up -d ai-models
# An empty EMBED_TEXT_MODEL or EMBED_IMAGE_MODEL turns that kind of vector
# off; its base URL, version and floor may then be empty too.
EMBED_TEXT_BASE_URL=https://openrouter.ai/api/v1
EMBED_IMAGE_BASE_URL=http://127.0.0.1:56810/v1
EMBED_TEXT_MODEL=baai/bge-m3
EMBED_IMAGE_MODEL=siglip2-so400m-patch16-384
# The model behind each alias; a new value re-embeds through search-reindex.
EMBED_TEXT_VERSION=bge-m3@5617a9f6
EMBED_IMAGE_VERSION=siglip2-so400m-patch16-384-fp32@29f74e67
# Locally your OpenRouter key (ai-models ignores it). In the cluster:
# server-embed-index's and server-embed-search's keys.
EMBED_INDEX_API_KEY=
EMBED_SEARCH_API_KEY=
EMBED_TIMEOUT=10s
EMBED_SLOTS=2
# Starting floors; make search-eval tunes them.
EMBED_TEXT_MIN_SIMILARITY=0.45
EMBED_PHOTO_MIN_SIMILARITY=0.6
# Video read (module assist; see ARCHITECTURE.md, Assist). Locally the server
# calls ai-models for frames and for speech to text, with no key; it runs
# under the profile models:
#   docker compose --profile models up -d ai-models
# In the cluster STT goes through ai-gateway's alias stt with server-stt's key.
AI_FRAMES_BASE_URL=http://127.0.0.1:56810/v1
STT_BASE_URL=http://127.0.0.1:56810/v1
STT_API_KEY=
STT_MODEL=gipformer-1.5
# The model that fills a listing from the frames and the transcript; it must
# read images. Every one is required; make run stops and names the one left
# empty. The values of LLM_* work when that model reads images.
ASSIST_LLM_BASE_URL=
ASSIST_LLM_API_KEY=
ASSIST_LLM_MODEL=
ASSIST_CALL_TIMEOUT=30s
# Chợ Tốt, for link reads: the public gateway and the CDN its photos are on.
CHOTOT_GATEWAY_URL=https://gateway.chotot.com
CHOTOT_CDN_URL=https://cdn.chotot.com
# The model that reads chats for scam warnings (module trust; see
# ARCHITECTURE.md, Trust). Every one is required; make run stops and names
# the one left empty. The values of LLM_* work here.
TRUST_LLM_BASE_URL=
TRUST_LLM_API_KEY=
TRUST_LLM_MODEL=
TRUST_CALL_TIMEOUT=20s

# The console agent (see ARCHITECTURE.md, Console agent): the agent service
# the console's agent endpoints forward to, and the address of the MCP
# server it reads through, apart from HTTP_ADDR. make run fills in both
# tokens, the one the server sends the agent and the one the agent sends the
# MCP server; the agent's .env takes the same two.
AGENT_BASE_URL=http://127.0.0.1:3000
AGENT_SERVICE_TOKEN=
AGENT_MCP_ADDR=127.0.0.1:9090
AGENT_MCP_TOKEN=

# Where shipments are made and read, on the accounts sellers link at GHTK
# and GHN (module shipping; see ARCHITECTURE.md, Shipping): fake, none or
# live. fake links any account but the password or token "wrong", knows
# every tracking code but those that start with NOTFOUND, and with it the
# server serves POST /v1/dev/shipments/{code}/status, which moves its
# shipments. none makes and reads no shipment; production runs it until the
# GHTK partner contract, and APP_ENV=prod refuses fake. live calls GHTK and
# GHN with the six settings below, which are empty with fake and none.
CARRIER=fake
# How often a shipped order's shipment is read from its carrier, under
# the carriers' webhooks.
CARRIER_POLL_EVERY=2h
# GHTK's API (staging https://services-staging.ghtklab.com), ShopNexus's B2C
# partner token and partner code, and the secret in GHTK's webhook path.
GHTK_API_URL=
GHTK_PARTNER_TOKEN=
GHTK_CLIENT_SOURCE=
GHTK_WEBHOOK_SECRET=
# GHN's API with its path (dev
# https://dev-online-gateway.ghn.vn/shiip/public-api), and the secret in
# GHN's webhook path.
GHN_API_URL=
GHN_WEBHOOK_SECRET=

# Firebase: the project pushes go through and phone tokens come from, and
# where the keys that sign those tokens are published.
FIREBASE_PROJECT_ID=shopnexus-26aca
FIREBASE_PROJECT_NUMBER=5362373878
FIREBASE_AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
PNV_JWKS_URL=https://fpnv.googleapis.com/v1beta/jwks
# Accept the test numbers of PNV's test mode; APP_ENV=prod refuses true.
PNV_TEST_NUMBERS=true
# Pushes through Firebase Cloud Messaging: a service account's JSON in
# base64. Empty writes pushes to the log instead.
FCM_CREDENTIALS=
# How sign-in codes are mailed: log (development) or resend. APP_ENV=prod
# refuses log.
EMAIL_SENDER=log
# Resend's API key; required with EMAIL_SENDER=resend.
RESEND_API_KEY=
EMAIL_FROM=ShopNexus <no-reply@shopnexus.id.vn>
# The Web OAuth client of the Firebase project, created when the Google
# provider is turned on; the app passes the same ID as serverClientId.
# Empty turns Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Every variable is required; an empty value above is a setting, not a gap.
# make run appends JWT_KEY_ID, JWT_PRIVATE_KEY, CONSOLE_KEY, OTP_KEY,
# CARRIER_TOKEN_KEY, AGENT_SERVICE_TOKEN, AGENT_MCP_TOKEN and
# RESTATE_IDENTITY_KEY to .env on first use. Each
# environment has its own CARRIER_TOKEN_KEY; a carrier token sealed under one
# does not open under another, and the seller links again.
