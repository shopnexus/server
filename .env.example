COMPOSE_PROFILES=obs
APP_ENV=dev
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text
DATABASE_URL=postgres://server2:server2@localhost:56432/server2?sslmode=disable
RESTATE_INGRESS_URL=http://127.0.0.1:56580
RESTATE_ADMIN_URL=http://127.0.0.1:56570
RESTATE_LISTEN_ADDR=127.0.0.1:9080
RESTATE_ENDPOINT_URL=http://127.0.0.1:9080
RESTATE_SERVICE_PREFIX=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:56318
SERVICE_NAME=server2
TRUSTED_PROXIES=
JWT_ISSUER=server2
JWT_AUDIENCE=shopnexus-app
# Set both during a key change; empty otherwise.
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_PUBLIC_KEY=
# The staff web console's origin; CORS allows it and nothing else.
STAFF_CONSOLE_ORIGIN=http://localhost:5173
# The object store (RustFS in docker-compose.yml) and the base URL clients
# read processed photos under.
OBJECT_STORE_ENDPOINT=http://127.0.0.1:56490
# The same API as phones reach it, e.g. http://<this machine's LAN IP>:56490;
# presigned upload URLs sign its host.
OBJECT_STORE_PUBLIC_ENDPOINT=http://127.0.0.1:56490
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=server2rustfs
OBJECT_STORE_SECRET_KEY=server2rustfs-secret
OBJECT_STORE_BUCKET=server2
MEDIA_PUBLIC_URL=http://127.0.0.1:56490/server2
# The model that reads search queries, through an OpenAI-compatible API.
# Every one is required; make run stops and names the one left empty.
LLM_BASE_URL=http://khoakomlem-internal.ddns.net:8317/v1
LLM_API_KEY=
LLM_MODEL=
# Every variable is required; an empty value above is a setting, not a gap.
# make run appends OTP_KEY, JWT_KEY_ID, JWT_PRIVATE_KEY, STAFF_KEY and
# RESTATE_IDENTITY_KEY to .env on first use.
